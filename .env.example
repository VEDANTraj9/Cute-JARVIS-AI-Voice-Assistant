# ================================================================
# Cute JARVIS AI Voice Assistant - Environment Configuration
# ================================================================

# OpenAI API Settings
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=350

# Voice & Speech Synthesis (Edge-TTS)
# Default language: en-US or hi-IN
DEFAULT_LANGUAGE=en-US

# Cute Voice Identifiers:
# English options: en-US-AnaNeural (Very cute child/teen girl), en-US-JennyNeural, en-US-AvaNeural
ENGLISH_VOICE=en-US-AnaNeural

# Hindi options: hi-IN-SwaraNeural (Sweet & expressive female), hi-IN-MadhurNeural
HINDI_VOICE=hi-IN-SwaraNeural

# Voice Modulation
VOICE_RATE=+0%
VOICE_PITCH=+5Hz
VOICE_VOLUME=+0%

# Assistant Persona & User Customization
ASSISTANT_NAME=JARVIS
USER_NAME=Sir
ASSISTANT_PERSONALITY=cute_loyal

# Microphone & Audio Settings
MIC_ENERGY_THRESHOLD=300
DYNAMIC_ENERGY_THRESHOLD=True
MIC_PHRASE_TIME_LIMIT=12
MIC_PAUSE_THRESHOLD=1.0

# Application Interface & Logging
APP_THEME=dark
LOG_LEVEL=INFO
DATABASE_PATH=data/jarvis_history.db
